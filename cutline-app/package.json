{
  "name": "omnimotion",
  "productName": "OmniMotion",
  "version": "0.1.0",
  "description": "Desktop editor for short-form video: talking-head edits and vlogs, driven by the edit-style engine.",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --win --config electron-builder.config.cjs",
    "shot": "node scripts/shot.mjs",
    "dist:dir": "vite build && electron-builder --win --dir --config electron-builder.config.cjs"
  },
  "dependencies": {
    "@fontsource/almarai": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/cairo": "5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/el-messiri": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/noto-kufi-arabic": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@fontsource/syne": "^5.3.0",
    "@fontsource/tajawal": "^5.3.0",
    "@phosphor-icons/react": "^2.1.7",
    "@remotion/player": "4.0.541",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.541"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "5.9.3",
    "vite": "^7.0.0"
  },
  "author": {
    "name": "OmniMotion"
  }
